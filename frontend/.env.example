# HealicWire Frontend Environment Configuration Example

# Backend API Endpoint URL (Leave empty or set to http://localhost:8080 locally; set to https://api.healicwire.in for Netlify Production)
VITE_API_URL=http://localhost:8080

# Supabase Public Anonymous Keys (Safe for frontend client bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
