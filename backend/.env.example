# HealicWire Backend Environment Configuration Example

# Server Port (Default for Cloud Run: 8080)
PORT=8080

# CORS Allowed Origins (Comma separated for multiple, or single origin in production)
# Example Production: https://healicwire.in,https://www.healicwire.in
# Example Local: http://localhost:5173,http://localhost:3001
CORS_ORIGIN=http://localhost:5173,https://healicwire.in,https://www.healicwire.in

# Google Gemini API Key (Secret Manager / Cloud Run Env)
GEMINI_API_KEY=

# Supabase Credentials (Backend privileged access only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication & Email Service Secrets
JWT_SECRET=
ZEPTOMAIL_API_KEY=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
